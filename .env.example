# =====================================================================
# SENTINELA — variáveis de ambiente
# Copie para .env.local (web) e .env (mobile). NUNCA commite os valores.
# =====================================================================

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Mesmos valores, prefixo exigido pelo Expo
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Bypassa RLS. Só no servidor (Edge Functions / route handlers). Nunca em NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_PROJECT_REF=SEU_PROJECT_REF

# ---------- Web ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Links de loja usados pela faixa que aparece quando o site abre no celular.
# Só existem depois da primeira submissão — vazios, a faixa some o botão
# "Instalar" e mantém apenas "Abrir o app".
NEXT_PUBLIC_IOS_APP_ID=
NEXT_PUBLIC_ANDROID_PACKAGE=app.sentinela

# ---------- Notificações ----------
RESEND_API_KEY=re_...
RESEND_FROM="Sentinela <alerta@sentinela.app>"

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_SMS_FROM=+15005550006
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

EXPO_ACCESS_TOKEN=

# ---------- Geocoding ----------
# Usado pela Edge Function reverse-geocode para preencher country_code/city.
MAPBOX_SECRET_TOKEN=sk.eyJ1...
# Alternativa gratuita (rate limit de 1 req/s — só para dev):
# NOMINATIM_USER_AGENT=sentinela-dev/0.1 (contato@sentinela.app)

# ---------- Billing ----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICE_NOMADE=price_...
NEXT_PUBLIC_STRIPE_PRICE_ORG=price_...

# ---------- OAuth de LOGIN (não é check-in passivo) ----------
# Só autenticação. O sinal de vida vem exclusivamente da localização do celular.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_SERVICE_ID=
